# CONFIGURACIÓN DE AMBIENTE
# Copia este archivo a .env.development o .env.production según el ambiente

# ============================================
# DESARROLLO LOCAL
# ============================================
# Backend corriendo localmente en puerto 5000
# npm run dev → http://localhost:5174
# Backend: http://localhost:5000
VITE_API_URL=http://localhost:5000/api
VITE_ENV=development
VITE_DEBUG=true
VITE_API_TIMEOUT=10000

# ============================================
# PRODUCCIÓN
# ============================================
# Backend en producción: https://api.brentrix.com
# Build estático servido desde: https://app.brentrix.com
# VITE_API_URL=https://api.brentrix.com/api
# VITE_ENV=production
# VITE_DEBUG=false
# VITE_API_TIMEOUT=15000

# ============================================
# NOTAS
# ============================================
# - VITE_API_URL debe incluir /api al final para desarrollo y producción
# - El archivo .env.development se usa automáticamente con: npm run dev
# - El archivo .env.production se usa automáticamente con: npm run build
# - El archivo .env.local sobrescribe todos (uso local/remoto de prueba)
